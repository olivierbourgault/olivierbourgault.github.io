---
interface Props {
  inDrawer?: boolean;
}

const { inDrawer = false } = Astro.props;
---
<button
  type="button"
  id={inDrawer ? undefined : 'langSwitcherBtn'}
  class="theme-switcher-btn lang-switcher-btn"
  data-toggle-site-lang
  aria-label="Switch to English — EN"
  title="Switch to English (EN)"
>
  <i class="bi bi-translate" aria-hidden="true"></i>
  <span class="lang-switcher-code" data-site-lang-code aria-hidden="true">EN</span>
</button>
