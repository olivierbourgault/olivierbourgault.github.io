---
import { LANGUAGES_AND_FRAMEWORKS, MARQUEE_ITEMS, SOFTWARES_AND_ENVS } from '../../data/skills';
---
<section id="skills" class="skills section" data-aos="fade-up" data-aos-delay="100">
  <div class="container">
    <!-- Infinite Skills Marquee -->
    <div class="tech-marquee-wrapper" data-aos="fade-up" data-aos-delay="150" aria-label="Compétences et technologies en continu">
      <div class="tech-marquee-ruler tech-marquee-ruler-top" aria-hidden="true"></div>
      <div class="tech-marquee-inner">
        <div class="tech-marquee-label">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>STACK TECH EN CONTINU</span>
        </div>
        <div class="tech-marquee-viewport" tabindex="0" role="region" aria-label="Défilement continu des compétences">
          <div class="tech-marquee-track">
            <div class="tech-marquee-group">
              {MARQUEE_ITEMS.map((item) => (
                <>
                  <span class="tech-marquee-item">
                    <i class={`bi ${item.icon}`} aria-hidden="true"></i> {item.label}
                  </span>
                  <span class="tech-marquee-sep" aria-hidden="true">&bull;</span>
                </>
              ))}
            </div>
            <div class="tech-marquee-group" aria-hidden="true">
              {MARQUEE_ITEMS.map((item) => (
                <>
                  <span class="tech-marquee-item">
                    <i class={`bi ${item.icon}`} aria-hidden="true"></i> {item.label}
                  </span>
                  <span class="tech-marquee-sep">&bull;</span>
                </>
              ))}
            </div>
          </div>
        </div>
      </div>
      <div class="tech-marquee-ruler tech-marquee-ruler-bottom" aria-hidden="true"></div>
    </div>

    <!-- Collapsible Skills Catalog -->
    <div id="skills-collapsable" class="mt-4 cta-buttons text-center">
      <div class="d-flex justify-content-center flex-wrap gap-3">
        <button
          id="btn-toggle-all-skills"
          class="btn text-nowrap"
          type="button"
          aria-expanded="false"
          aria-controls="languages softwares"
          aria-label="Afficher ou masquer toutes les compétences"
        >
          <i class="bi bi-grid-3x3-gap-fill me-2" aria-hidden="true"></i>
          <span id="toggle-all-text">Tout afficher (Tous)</span>
        </button>
      </div>

      <div class="skills-collapse-wrap" id="languages">
        <div class="skills-collapse-inner">
          <div class="card card-body rounded-3 text-center">
            <div class="col-6 mx-auto w-auto">
              {LANGUAGES_AND_FRAMEWORKS.map((skill) => (
                <span class="btn btn-outline m-1">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div class="skills-collapse-wrap" id="softwares">
        <div class="skills-collapse-inner">
          <div class="card card-body rounded-3 text-center">
            <div class="col-6 mx-auto w-auto">
              {SOFTWARES_AND_ENVS.map((tool) => (
                <span class="btn btn-outline m-1">{tool}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
