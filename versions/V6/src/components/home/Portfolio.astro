---
import { FALLBACK_PROJECTS, PORTFOLIO_TECH_TAGS } from '../../data/projects';
import { SITE } from '../../data/site';
import { withBase } from '../../utils/paths';
import SectionTitle from '../SectionTitle.astro';
import VerticalNav, { type VerticalNavItem } from '../VerticalNav.astro';

const initialNavItems: VerticalNavItem[] = FALLBACK_PROJECTS.slice(0, 5).map((p, idx) => ({
  targetId: `portfolio-item-${idx}`,
  title: p.name,
  sub: p.categoryLabel
}));
---
<section id="portfolio" class="portfolio section" data-aos="fade-up" data-aos-delay="100">
  <SectionTitle title="Portfolio">
    <p class="portfolio-text">
      Découvrez une sélection de mes réalisations scolaires, professionnelles et personnelles.<br />
      Pour explorer l'ensemble de mon code source, visitez mon dépôt{' '}
      <a href={SITE.githubProjectsUrl} target="_blank" rel="noopener noreferrer">GitHub</a>.
    </p>
  </SectionTitle>

  <div class="isotope-layout">
    <VerticalNav
      id="vnav-portfolio-list"
      heading="Projets (Accès rapide)"
      ariaLabel="Projets (Accès rapide)"
      items={initialNavItems}
    >
      <div class="portfolio-filters-container" data-aos="fade-up" data-aos-delay="200">
        <ul class="portfolio-filters isotope-filters" id="filters" aria-label="Filtrer les projets par catégorie">
          <li>
            <button type="button" data-filter="*" class="portfolio-filter-btn filter-active" aria-pressed="true">
              Tout
            </button>
          </li>
          <li>
            <button type="button" data-filter=".filter-school" class="portfolio-filter-btn" aria-pressed="false">
              Scolaires
            </button>
          </li>
          <li>
            <button type="button" data-filter=".filter-professional" class="portfolio-filter-btn" aria-pressed="false">
              Professionnels
            </button>
          </li>
          <li>
            <button type="button" data-filter=".filter-personal" class="portfolio-filter-btn" aria-pressed="false">
              Personnels
            </button>
          </li>
        </ul>

        <!-- Barre de recherche & Filtres rapides par technologie -->
        <div class="portfolio-discovery-bar mt-3">
          <div class="portfolio-search-wrap">
            <i class="bi bi-search portfolio-search-icon" aria-hidden="true"></i>
            <input
              id="portfolioSearchInput"
              type="search"
              class="portfolio-search-input"
              placeholder="Rechercher un projet ou une techno (ex. Python, PowerShell, C#, Angular…)"
              aria-label="Rechercher un projet par nom, description ou technologie"
              autocomplete="off"
            />
            <button
              id="portfolioSearchClear"
              type="button"
              class="portfolio-search-clear d-none"
              aria-label="Effacer la recherche"
              title="Effacer la recherche"
            >
              <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
          </div>

          <div
            id="portfolioTechTags"
            class="portfolio-tech-tags"
            role="group"
            aria-label="Filtrer par technologie"
          >
            {
              PORTFOLIO_TECH_TAGS.map((tag) => (
                <button
                  type="button"
                  class={`portfolio-tech-chip${tag === '*' ? ' is-active' : ''}`}
                  data-tech-tag={tag}
                  aria-pressed={tag === '*' ? 'true' : 'false'}
                >
                  {tag === '*' ? <span data-i18n="portfolio.tech.all">Toutes technos</span> : tag}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <p id="portfolioSyncStatus" class="visually-hidden" aria-live="polite"></p>

      <div id="portfolioGrid" class="row g-4 isotope-container" data-aos="fade-up" data-aos-delay="300">
        {
          FALLBACK_PROJECTS.map((project, idx) => (
            <div
              id={`portfolio-item-${idx}`}
              class={`col-lg-6 col-md-6 portfolio-item ${project.filterClass}${idx >= 5 ? ' d-none' : ''}`}
              data-project-path={project.path}
              data-project-tags={project.badges.join('|')}
            >
              <div class="portfolio-card">
                <div class="portfolio-image">
                  <img
                    src={withBase(project.image)}
                    width={project.width}
                    height={project.height}
                    class="img-fluid"
                    alt={project.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  {project.caseStudy && (
                    <span class="portfolio-casestudy-ribbon" data-i18n="portfolio.casestudy.ribbon">
                      ÉTUDE DE CAS
                    </span>
                  )}
                  <div class="portfolio-overlay">
                    <div class="portfolio-actions">
                      <a
                        href={withBase(project.image)}
                        class="glightbox preview-link"
                        data-gallery={project.gallery}
                        aria-label={`Agrandir l'aperçu de ${project.name}`}
                        title={`Agrandir l'aperçu de ${project.name}`}
                      >
                        <i class="bi bi-eye" aria-hidden="true"></i>
                      </a>
                      <a
                        href={project.repoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="details-link"
                        aria-label={`Voir le code source de ${project.name} sur GitHub`}
                        title={`Voir le code source de ${project.name} sur GitHub`}
                      >
                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                      </a>
                    </div>
                  </div>
                </div>
                <div class="portfolio-content">
                  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <span class="category">{project.categoryLabel}</span>
                    {project.caseStudy && (
                      <button
                        type="button"
                        class="case-study-trigger-btn"
                        data-case-study={project.name}
                      >
                        <i class="bi bi-journal-code" aria-hidden="true"></i>
                        <span data-i18n="portfolio.casestudy.btn">Étude de cas</span>
                      </button>
                    )}
                  </div>
                  <h3>{project.name}</h3>
                  <p class="text-break" set:html={project.descriptionHtml} />
                  <div class="d-flex flex-wrap gap-1 mt-2">
                    {project.badges.map((badge) => (
                      <span class="badge badge-tech">{badge}</span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <div id="portfolioEmptyState" class="portfolio-empty-state d-none text-center mt-4">
        <p id="portfolioEmptyText" class="mb-2">Aucun projet ne correspond à ces critères de recherche.</p>
        <button id="portfolioResetFiltersBtn" type="button" class="versions-btn-outline ob-dialog-btn-sm">
          <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
          <span data-i18n="portfolio.filter.reset">Réinitialiser les filtres</span>
        </button>
      </div>

      <div id="portfolioShowMoreWrap" class="text-center mt-4">
        <button id="portfolioShowMoreBtn" type="button" class="btn btn-submit">
          <i class="bi bi-grid-3x3-gap-fill me-2" aria-hidden="true"></i>Voir plus (+1)
        </button>
      </div>
    </VerticalNav>
  </div>

  <!-- Visionneuse d'aperçu native -->
  <dialog id="portfolioLightboxDialog" class="ob-dialog ob-lightbox-dialog" closedby="any" aria-labelledby="lightboxDialogTitle">
    <div class="ob-dialog-header">
      <div class="ob-dialog-title-wrap">
        <span class="ob-dialog-icon" aria-hidden="true"><i class="bi bi-eye"></i></span>
        <div>
          <h2 id="lightboxDialogTitle" class="ob-dialog-title">Aperçu du projet</h2>
          <span id="lightboxDialogSub" class="ob-dialog-sub">Portfolio Olivier Bourgault</span>
        </div>
      </div>
      <button type="button" class="ob-dialog-close" data-close-dialog aria-label="Fermer l'aperçu" title="Fermer l'aperçu" autofocus>
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>
    <div class="ob-lightbox-body">
      <img id="lightboxDialogImg" class="ob-lightbox-img" src="" alt="" />
    </div>
  </dialog>

  <!-- Modale Étude de cas (Case Study) pour les projets phares -->
  <dialog id="caseStudyDialog" class="ob-dialog ob-casestudy-dialog" closedby="any" aria-labelledby="caseStudyDialogTitle">
    <div class="ob-dialog-header">
      <div class="ob-dialog-title-wrap">
        <span class="ob-dialog-icon" aria-hidden="true"><i class="bi bi-journal-code"></i></span>
        <div>
          <h2 id="caseStudyDialogTitle" class="ob-dialog-title">Étude de cas</h2>
          <span id="caseStudyDialogSub" class="ob-dialog-sub">Analyse technique &amp; architecture</span>
        </div>
      </div>
      <button type="button" class="ob-dialog-close" data-close-dialog aria-label="Fermer l'étude de cas" title="Fermer l'étude de cas" autofocus>
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </div>
    <div id="caseStudyDialogBody" class="ob-dialog-body ob-casestudy-body"></div>
    <div class="ob-dialog-footer">
      <span id="caseStudyDialogBadges" class="d-flex flex-wrap gap-1"></span>
      <a
        id="caseStudyDialogRepoLink"
        href={SITE.githubProjectsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="versions-btn-primary ob-dialog-btn-sm"
      >
        <i class="bi bi-github" aria-hidden="true"></i>
        <span data-i18n="portfolio.casestudy.repo">Explorer le code sur GitHub</span>
      </a>
    </div>
  </dialog>
</section>
