---
import LogoOB from './LogoOB.astro';
import { SITE } from '../data/site';
import { withBase } from '../utils/paths';

const currentYear = new Date().getFullYear();
---
<footer id="footer" class="footer">
  <div class="d-flex justify-content-center align-items-center gap-2 mb-2">
    <LogoOB size={28} ariaHidden={true} />
    <span class="fw-bold ob-footer-brand">OB TECH &bull; PORTFOLIO</span>
  </div>

  <div class="copyright text-center">
    <p>&copy; {currentYear} <span>Copyright</span> <strong class="px-1 sitename">{SITE.author}</strong></p>
    <span>Tous droits réservés</span>
  </div>

  <div class="social-links d-flex justify-content-center">
    <a href={withBase('')} aria-label="Accueil du portfolio" title="Accueil (V6)">
      <i class="bi bi-house-door" aria-hidden="true"></i>
    </a>
    <a href={withBase('versions')} aria-label="Navigateur de versions" title="Navigateur de versions">
      <i class="bi bi-clock-history" aria-hidden="true"></i>
    </a>
    <a href={withBase('identity')} aria-label="Identité visuelle" title="Identité visuelle">
      <i class="bi bi-palette2" aria-hidden="true"></i>
    </a>
    <a href={withBase('resume')} aria-label="CV - Aperçu" title="CV - Aperçu">
      <i class="bi bi-file-earmark-person" aria-hidden="true"></i>
    </a>
    <a href={SITE.githubUrl} target="_blank" rel="noopener noreferrer" aria-label="Profil Github" title="Profil GitHub">
      <i class="bi bi-github" aria-hidden="true"></i>
    </a>
    <a href={SITE.linkedinUrl} target="_blank" rel="noopener noreferrer" aria-label="Profil Linkedin" title="Profil LinkedIn">
      <i class="bi bi-linkedin" aria-hidden="true"></i>
    </a>
  </div>

  <div class="credits" data-i18n="footer.credits">
    Conçu et développé avec Astro &middot; Direction Tech Canvas
  </div>
</footer>
