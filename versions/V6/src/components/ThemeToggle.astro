---
interface Props {
  inDrawer?: boolean;
}

const { inDrawer = false } = Astro.props;
---
<button
  type="button"
  id={inDrawer ? undefined : 'themeSwitcherBtn'}
  class="theme-switcher-btn"
  data-theme-toggle
  aria-label="Passer au mode clair"
  title="Passer au mode clair"
  aria-pressed="true"
>
  <i id={inDrawer ? undefined : 'themeSwitcher'} data-theme-icon class="bi bi-sun-fill" aria-hidden="true"></i>
</button>
