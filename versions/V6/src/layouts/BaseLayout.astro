---
import '../styles/fonts.css';
import '../styles/utilities.css';
import '../styles/icons.css';
import '../styles/tokens.css';
import '../styles/main.css';
import '../styles/components/dialog.css';

import { SITE } from '../data/site';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  titleEn?: string;
  descriptionEn?: string;
  keywords?: string;
  canonicalPath?: string;
  bodyClass: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogImageAlt?: string;
  isCvPage?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  titleEn,
  descriptionEn,
  keywords,
  canonicalPath = '',
  bodyClass,
  ogTitle = title,
  ogDescription = description,
  ogImage = 'assets/images/og-card.png',
  ogImageAlt = "Olivier Bourgault — Développeur Full-Stack, IA & Technicien TI",
  isCvPage = false,
  noindex = false
} = Astro.props;

const SITE_ORIGIN = 'https://olivierbourgault.github.io';
const normalizedPath = canonicalPath.replace(/^\/+/, '');
const canonicalUrl = `${SITE_ORIGIN}/${normalizedPath}`;
const enAlternateUrl = `${canonicalUrl}?lang=en`;
const ogImageUrl = ogImage.startsWith('http')
  ? ogImage
  : `${SITE_ORIGIN}/${ogImage.replace(/^\/+/, '')}`;

const structuredData = noindex
  ? null
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': `${SITE_ORIGIN}/#website`,
          url: `${SITE_ORIGIN}/`,
          name: 'Olivier Bourgault — Portfolio',
          inLanguage: ['fr-CA', 'en-CA'],
          publisher: { '@id': `${SITE_ORIGIN}/#person` }
        },
        {
          '@type': 'Person',
          '@id': `${SITE_ORIGIN}/#person`,
          name: SITE.author,
          jobTitle: SITE.roleTitle,
          url: `${SITE_ORIGIN}/`,
          image: `${SITE_ORIGIN}/assets/images/hero-avatar.webp`,
          email: `mailto:${SITE.email}`,
          address: {
            '@type': 'PostalAddress',
            addressLocality: 'Gatineau',
            addressRegion: 'QC',
            addressCountry: 'CA'
          },
          sameAs: [SITE.githubUrl, SITE.linkedinUrl],
          knowsLanguage: ['fr-CA', 'en-CA'],
          knowsAbout: [
            'Développement Web Full-Stack',
            'Intelligence Artificielle',
            'Automatisation TI',
            'Accessibilité Web (WCAG)',
            'TypeScript',
            'Python',
            'C#',
            'PowerShell'
          ]
        },
        {
          '@type': 'WebPage',
          '@id': `${canonicalUrl}#webpage`,
          url: canonicalUrl,
          name: title,
          description,
          isPartOf: { '@id': `${SITE_ORIGIN}/#website` },
          about: { '@id': `${SITE_ORIGIN}/#person` },
          inLanguage: 'fr-CA'
        }
      ]
    };
---
<!DOCTYPE html>
<html
  lang="fr"
  data-cv-version={isCvPage ? 'portfolio' : undefined}
  data-title-fr={title}
  data-title-en={titleEn}
  data-desc-fr={description}
  data-desc-en={descriptionEn}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#121316" />

    <!-- Résolution synchrone du thème avant le premier rendu (zéro FOUC) -->
    <script is:inline define:vars={{ themeKey: SITE.themeStorageKey }}>
      (function () {
        var mode = 'dark';
        try {
          if (localStorage.getItem(themeKey) === 'light') mode = 'light';
        } catch (e) {}
        var isDark = mode === 'dark';
        var html = document.documentElement;
        html.dataset.theme = mode;
        html.dataset.bsTheme = mode;
        html.classList.toggle('dark', isDark);
        html.classList.toggle('theme-light', !isDark);
        var meta = document.querySelector('meta[name="color-scheme"]');
        if (meta) meta.setAttribute('content', mode);
        var themeColor = document.querySelector('meta[name="theme-color"]');
        if (themeColor) themeColor.setAttribute('content', isDark ? '#121316' : '#F4F1EA');
      })();
    </script>
    <style is:inline>
      html {
        background-color: #121316;
        transition: background-color 0.35s ease;
      }
      html.theme-light {
        background-color: #F4F1EA;
      }
    </style>

    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

    {!noindex && (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="fr-CA" href={canonicalUrl} />
        <link rel="alternate" hreflang="en-CA" href={enAlternateUrl} />
        <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
      </>
    )}

    <!-- Open Graph & Twitter Card -->
    <meta property="og:site_name" content={SITE.author} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:locale:alternate" content="en_CA" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}

    <!-- Favicons & Web App Manifest -->
    <link href={withBase('assets/images/logos/logo-ob-tech.svg')} rel="icon" type="image/svg+xml" />
    <link href={withBase('assets/images/favicon.svg')} rel="alternate icon" type="image/svg+xml" />
    <link href={withBase('site.webmanifest')} rel="manifest" />

    <slot name="head" />
  </head>

  <body
    class={bodyClass}
    data-bs-theme="dark"
    data-palette="tech-canvas"
    data-cv-version={isCvPage ? 'portfolio' : undefined}
  >
    <script is:inline>
      (function () {
        var isDark = !document.documentElement.classList.contains('theme-light');
        document.body.classList.toggle('dark', isDark);
        if (isDark) {
          document.body.setAttribute('data-bs-theme', 'dark');
        } else {
          document.body.removeAttribute('data-bs-theme');
        }
      })();
    </script>

    <a href="#main-content" class="skip-link visually-hidden-focusable">Aller au contenu principal</a>

    <!-- Curseur interactif Aahil Khan + Halo radial orange -->
    <div id="laser-dot" popover="manual" aria-hidden="true"></div>

    <!-- Animated Tech Canvas Constellation & Reactive Grid Background -->
    <canvas id="tech-bg-canvas" aria-hidden="true"></canvas>

    <!-- Ambient Background Blobs -->
    <div class="ambient-blobs" aria-hidden="true">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <slot />

    <script>
      import { initTheme } from '../scripts/theme';
      import { initSiteLang } from '../scripts/i18n';
      import { initNavbar } from '../scripts/navbar';
      import { initAnimatedBackground } from '../scripts/bg-canvas';
      import { initInteractiveCursor } from '../scripts/cursor';
      import { initNativeDialogs } from '../scripts/dialogs';

      const runBaseInit = () => {
        initTheme();
        initSiteLang();
        initNavbar();
        initAnimatedBackground();
        initInteractiveCursor();
        initNativeDialogs();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', runBaseInit);
      } else {
        runBaseInit();
      }
    </script>
  </body>
</html>
