---
import { withBase } from '../utils/paths';

const target = withBase('resume');
const canonical = 'https://olivierbourgault.github.io/resume';
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, follow" />
    <title>CV - Aperçu — Redirection vers /resume</title>
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link href={withBase('assets/images/logos/logo-ob-tech.svg')} rel="icon" type="image/svg+xml" />
    <script is:inline define:vars={{ target }}>
      window.location.replace(target + window.location.search + window.location.hash);
    </script>
  </head>
  <body>
    <main>
      <p>Redirection vers <a href={target}>/resume</a>…</p>
    </main>
  </body>
</html>
