---
import BootLoader from '../components/BootLoader.astro';
import CvDownloadDialog from '../components/CvDownloadDialog.astro';
import ScrollTop from '../components/ScrollTop.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import About from '../components/home/About.astro';
import Contact from '../components/home/Contact.astro';
import Hero from '../components/home/Hero.astro';
import Portfolio from '../components/home/Portfolio.astro';
import Resume from '../components/home/Resume.astro';
import Skills from '../components/home/Skills.astro';
import TechPillars from '../components/home/TechPillars.astro';
import { type NavLinkItem } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';

const navLinks: NavLinkItem[] = [
  { label: 'Accueil', href: '#hero', active: true },
  { label: 'À propos', href: '#about' },
  { label: 'CV', href: '#resume' },
  { label: 'Portfolio', href: '#portfolio' },
  { label: 'Contact', href: '#contact' }
];
---
<BaseLayout
  title="Olivier Bourgault | Développeur Full-Stack, IA & Technicien TI — Tech Canvas"
  description="Portfolio officiel d'Olivier Bourgault, diplômé en technique de l'informatique et étudiant en intelligence artificielle. Spécialisé en développement d'applications, automatisation et accessibilité Web."
  titleEn="Olivier Bourgault | Full-Stack Developer, AI & IT Technician — Tech Canvas"
  descriptionEn="Official portfolio of Olivier Bourgault, Computer Science graduate and Artificial Intelligence student. Specialized in application development, automation, and Web accessibility (WCAG)."
  keywords="Portfolio, Olivier Bourgault, Développeur Web, Intelligence Artificielle, Technicien informatique, Automatisation, Gatineau, Angular, Vue, Symfony, C#, Python, PowerShell"
  canonicalPath=""
  bodyClass="index-page dark"
>
  <noscript slot="head">
    <style>
      #spinner { display: none !important; }
      #page { display: block !important; }
      [data-aos] { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>

  <BootLoader />

  <script is:inline>
    (function () {
      try {
        var params = new URLSearchParams(window.location.search);
        var skip =
          params.get('embed') === '1' ||
          window.self !== window.top ||
          window.sessionStorage.getItem('ob_v6_boot_seen') === '1' ||
          (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
        if (skip) {
          var sp = document.getElementById('spinner');
          if (sp) sp.classList.add('d-none');
        }
      } catch (e) {}
    })();
  </script>

  <div id="page">
    <SiteHeader
      links={navLinks}
      currentPage="home"
      drawerExtras={[
        { href: withBase('versions'), icon: 'bi-layers', label: 'Versions et identité visuelle', title: 'Versions & Identité visuelle' }
      ]}
    />

    <main id="main-content" class="main" tabindex="-1">
      <Hero />
      <TechPillars />
      <About />
      <Skills />
      <Resume />
      <Portfolio />
      <Contact />
    </main>

    <SiteFooter />
  </div>

  <CvDownloadDialog />
  <ScrollTop />

  <script>
    import { initHomePage } from '../scripts/home';

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHomePage);
    } else {
      initHomePage();
    }
  </script>
</BaseLayout>
